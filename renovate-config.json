{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "platformCommit": true,
  "assigneesFromCodeOwners": true,
  "reviewersFromCodeOwners": false,
  "prHourlyLimit": 2,
  "prConcurrentLimit": 5,
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Dependency Dashboard",
  "schedule": ["after 22:00", "before 23:00"],
  "timezone": "UTC",
  "labels": ["dependencies"],
  "rangeStrategy": "replace",
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "commitMessagePrefix": "chore(deps):",
  "prTitle": "{{semanticCommitType}}({{semanticCommitScope}}): {{#if isMajor}}update {{depName}} to {{newVersion}} (major){{else if isMinor}}update {{depName}} to {{newVersion}} (minor){{else}}{{#if newVersion}}update {{depName}} to {{newVersion}}{{else}}update {{depName}} digest{{/if}}{{/if}}",
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "pinDigests": true,
      "groupName": "github-actions",
      "separateMinorPatch": false
    },
    {
      "description": "Group lgtm-ci reusable workflow and tooling pins",
      "matchManagers": ["github-actions", "regex"],
      "matchPackageNames": ["lgtm-hq/lgtm-ci"],
      "groupName": "lgtm-ci",
      "groupSlug": "lgtm-ci",
      "automerge": false
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["patch", "digest"],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps-dev",
      "commitMessagePrefix": "chore(deps-dev):"
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": [
        "dependencies",
        "optionalDependencies",
        "peerDependencies"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps",
      "commitMessagePrefix": "fix(deps):"
    },
    {
      "matchManagers": ["pep621", "uv"],
      "matchDepTypes": [
        "dependency-groups",
        "tool.uv.dev-dependencies",
        "tool.pdm.dev-dependencies"
      ],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps-dev",
      "commitMessagePrefix": "chore(deps-dev):"
    },
    {
      "matchManagers": ["pep621", "uv"],
      "matchDepTypes": [
        "project.dependencies",
        "project.optional-dependencies"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps",
      "commitMessagePrefix": "fix(deps):"
    },
    {
      "matchManagers": ["poetry"],
      "matchDepTypes": ["dev-dependencies", "dev"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps-dev",
      "commitMessagePrefix": "chore(deps-dev):"
    },
    {
      "matchManagers": ["poetry"],
      "matchDepTypes": [
        "dependencies",
        "extras",
        "project.dependencies",
        "project.optional-dependencies"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps",
      "commitMessagePrefix": "fix(deps):"
    },
    {
      "matchManagers": ["cargo"],
      "matchDepTypes": ["dev-dependencies", "build-dependencies"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps-dev",
      "commitMessagePrefix": "chore(deps-dev):"
    },
    {
      "matchManagers": ["cargo"],
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps",
      "commitMessagePrefix": "fix(deps):"
    },
    {
      "matchManagers": ["pipenv"],
      "matchDepTypes": ["dev-packages"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps-dev",
      "commitMessagePrefix": "chore(deps-dev):"
    },
    {
      "matchManagers": ["pipenv"],
      "matchDepTypes": ["packages"],
      "matchUpdateTypes": ["minor", "patch"],
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps",
      "commitMessagePrefix": "fix(deps):"
    },
    {
      "matchManagers": ["pip_setup", "setup-cfg"],
      "matchDepTypes": [
        "tests_require",
        "setup_requires",
        "extras_require:dev",
        "extras_require:test",
        "extras_require:testing",
        "extras_require:lint"
      ],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps-dev",
      "commitMessagePrefix": "chore(deps-dev):"
    },
    {
      "matchManagers": ["pip_setup", "setup-cfg"],
      "matchDepTypes": ["install_requires"],
      "matchUpdateTypes": ["minor", "patch"],
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps",
      "commitMessagePrefix": "fix(deps):"
    },
    {
      "matchManagers": ["pip_requirements"],
      "matchFileNames": ["**/requirements*.txt"],
      "matchUpdateTypes": ["minor", "patch"],
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps",
      "commitMessagePrefix": "fix(deps):"
    },
    {
      "matchManagers": ["pip_requirements"],
      "matchFileNames": [
        "**/requirements-dev*.txt",
        "**/dev-requirements*.txt",
        "**/requirements-test*.txt",
        "**/test-requirements*.txt",
        "**/requirements/dev*.txt",
        "**/requirements/test*.txt"
      ],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps-dev",
      "commitMessagePrefix": "chore(deps-dev):"
    },
    {
      "matchUpdateTypes": ["digest"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps",
      "commitMessagePrefix": "chore(deps):"
    },
    {
      "matchUpdateTypes": ["patch", "digest"],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "groupName": "test-tools",
      "matchPackageNames": [
        "pytest",
        "pytest-**",
        "vitest",
        "@vitest/**",
        "jest",
        "@jest/**",
        "jest-**",
        "playwright",
        "@playwright/**",
        "mocha",
        "chai",
        "bats",
        "bats-**"
      ]
    },
    {
      "matchUpdateTypes": ["minor", "major"],
      "automerge": false
    },
    {
      "matchUpdateTypes": ["major"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps",
      "commitMessagePrefix": "chore(deps):",
      "groupName": "all major dependencies",
      "groupSlug": "all-major",
      "matchPackageNames": ["**"]
    },
    {
      "matchDepTypes": ["requires-python"],
      "matchManagers": ["pep621"],
      "enabled": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "semanticCommitType": "chore",
    "semanticCommitScope": "deps",
    "commitMessagePrefix": "chore(deps):"
  },
  "customManagers": [
    {
      "description": "Track lgtm-ci tooling-ref SHA pins (single-quoted, not visible to github-actions manager)",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": [
        "tooling-ref:\\s*'[a-f0-9]{40}'\\s*#\\s*v(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "lgtm-hq/lgtm-ci",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "autoReplaceStringTemplate": "tooling-ref: '{{newDigest}}'  # v{{newVersion}}"
    },
    {
      "description": "Track lgtm-ci tooling-ref SHA pins (double-quoted, not visible to github-actions manager)",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": [
        "tooling-ref:\\s*\"[a-f0-9]{40}\"\\s*#\\s*v(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "lgtm-hq/lgtm-ci",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "autoReplaceStringTemplate": "tooling-ref: \"{{newDigest}}\"  # v{{newVersion}}"
    },
    {
      "description": "Track manual lgtm-ci checkout ref pins (single-quoted)",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": [
        "(?s)repository:\\s*lgtm-hq/lgtm-ci.*?ref:\\s*'[a-f0-9]{40}'\\s*#\\s*v(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "lgtm-hq/lgtm-ci",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "autoReplaceStringTemplate": "ref: '{{newDigest}}'  # v{{newVersion}}"
    },
    {
      "description": "Track manual lgtm-ci checkout ref pins (double-quoted)",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": [
        "(?s)repository:\\s*lgtm-hq/lgtm-ci.*?ref:\\s*\"[a-f0-9]{40}\"\\s*#\\s*v(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "lgtm-hq/lgtm-ci",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "autoReplaceStringTemplate": "ref: \"{{newDigest}}\"  # v{{newVersion}}"
    }
  ]
}
