{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "osvVulnerabilityAlerts": true,
  "dependencyDashboardOSVVulnerabilitySummary": "unresolved",
  "vulnerabilityAlerts": {
    "addLabels": [
      "security"
    ],
    "commitMessageSuffix": "[SECURITY]",
    "automerge": false
  },
  "platformCommit": "enabled",
  "assigneesFromCodeOwners": true,
  "reviewersFromCodeOwners": false,
  "prHourlyLimit": 2,
  "prConcurrentLimit": 5,
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Dependency Dashboard",
  "schedule": [
    "after 22:00",
    "before 23:00"
  ],
  "timezone": "UTC",
  "labels": [
    "dependencies"
  ],
  "rangeStrategy": "replace",
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github-actions",
      "separateMinorPatch": false
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "devDependencies"
      ],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps-dev"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "dependencies",
        "optionalDependencies",
        "peerDependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps"
    },
    {
      "matchManagers": [
        "pep621",
        "uv"
      ],
      "matchDepTypes": [
        "dependency-groups",
        "tool.uv.dev-dependencies",
        "tool.pdm.dev-dependencies"
      ],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps-dev"
    },
    {
      "matchManagers": [
        "pep621",
        "uv"
      ],
      "matchDepTypes": [
        "project.dependencies",
        "project.optional-dependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps"
    },
    {
      "matchManagers": [
        "poetry"
      ],
      "matchDepTypes": [
        "dev-dependencies",
        "dev"
      ],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps-dev"
    },
    {
      "matchManagers": [
        "poetry"
      ],
      "matchDepTypes": [
        "dependencies",
        "extras",
        "project.dependencies",
        "project.optional-dependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps"
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "matchDepTypes": [
        "dev-dependencies",
        "build-dependencies"
      ],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps-dev"
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "matchDepTypes": [
        "dependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps"
    },
    {
      "matchManagers": [
        "pipenv"
      ],
      "matchDepTypes": [
        "dev-packages"
      ],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps-dev"
    },
    {
      "matchManagers": [
        "pipenv"
      ],
      "matchDepTypes": [
        "packages"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps"
    },
    {
      "matchManagers": [
        "pip_setup",
        "setup-cfg"
      ],
      "matchDepTypes": [
        "tests_require",
        "setup_requires",
        "extras_require:dev",
        "extras_require:test",
        "extras_require:testing",
        "extras_require:lint"
      ],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps-dev"
    },
    {
      "matchManagers": [
        "pip_setup",
        "setup-cfg"
      ],
      "matchDepTypes": [
        "install_requires"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps"
    },
    {
      "matchManagers": [
        "pip_requirements"
      ],
      "matchFileNames": [
        "**/requirements*.txt"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps"
    },
    {
      "matchManagers": [
        "pip_requirements"
      ],
      "matchFileNames": [
        "**/requirements-dev*.txt",
        "**/dev-requirements*.txt",
        "**/requirements-test*.txt",
        "**/test-requirements*.txt",
        "**/requirements/dev*.txt",
        "**/requirements/test*.txt"
      ],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps-dev"
    },
    {
      "matchUpdateTypes": [
        "digest"
      ],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    },
    {
      "matchUpdateTypes": [
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "groupName": "test-tools",
      "matchPackageNames": [
        "pytest",
        "pytest-**",
        "vitest",
        "@vitest/**",
        "jest",
        "@jest/**",
        "jest-**",
        "playwright",
        "@playwright/**",
        "mocha",
        "chai",
        "bats",
        "bats-**"
      ]
    },
    {
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "automerge": false
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps",
      "groupName": "all major dependencies",
      "groupSlug": "all-major",
      "matchPackageNames": [
        "**"
      ]
    },
    {
      "matchDepTypes": [
        "requires-python"
      ],
      "matchManagers": [
        "pep621"
      ],
      "enabled": false
    },
    {
      "description": "Group lintro Docker image and PyPI package updates",
      "groupName": "lintro",
      "groupSlug": "lintro",
      "matchPackageNames": [
        "ghcr.io/lgtm-hq/py-lintro",
        "lintro"
      ]
    },
    {
      "description": "Automerge lintro group except majors (breaking releases need review)",
      "matchPackageNames": [
        "ghcr.io/lgtm-hq/py-lintro",
        "lintro"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor",
        "digest",
        "pin",
        "pinDigest"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Group lgtm-ci reusable workflow and tooling pins",
      "matchManagers": [
        "github-actions",
        "custom.regex"
      ],
      "matchPackageNames": [
        "/^lgtm-hq\\/lgtm-ci/"
      ],
      "groupName": "lgtm-ci",
      "groupSlug": "lgtm-ci",
      "automerge": false
    },
    {
      "description": "Show version and update type in titles, incl. grouped PRs",
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "commitMessageExtra": "to {{newVersion}} ({{updateType}})"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "semanticCommitType": "chore",
    "semanticCommitScope": "deps"
  },
  "customManagers": [
    {
      "description": "Track lgtm-ci tooling-ref SHA pins (single-quoted, not visible to github-actions manager)",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "tooling-ref:\\s*'(?<currentDigest>[a-f0-9]{40})'\\s*#\\s*(?<currentValue>v[0-9]+(?:\\.[0-9]+)*)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "lgtm-hq/lgtm-ci",
      "autoReplaceStringTemplate": "tooling-ref: '{{newDigest}}'  # {{newVersion}}"
    },
    {
      "description": "Track lgtm-ci tooling-ref SHA pins (double-quoted, not visible to github-actions manager)",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "tooling-ref:\\s*\"(?<currentDigest>[a-f0-9]{40})\"\\s*#\\s*(?<currentValue>v[0-9]+(?:\\.[0-9]+)*)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "lgtm-hq/lgtm-ci",
      "autoReplaceStringTemplate": "tooling-ref: \"{{newDigest}}\"  # {{newVersion}}"
    },
    {
      "description": "Track manual lgtm-ci checkout ref pins (single-quoted)",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?s)repository:\\s*lgtm-hq/lgtm-ci.*?(?<replaceString>ref:\\s*'(?<currentDigest>[a-f0-9]{40})'\\s*#\\s*(?<currentValue>v[0-9]+(?:\\.[0-9]+)*))"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "lgtm-hq/lgtm-ci",
      "autoReplaceStringTemplate": "ref: '{{newDigest}}'  # {{newVersion}}"
    },
    {
      "description": "Track manual lgtm-ci checkout ref pins (double-quoted)",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?s)repository:\\s*lgtm-hq/lgtm-ci.*?(?<replaceString>ref:\\s*\"(?<currentDigest>[a-f0-9]{40})\"\\s*#\\s*(?<currentValue>v[0-9]+(?:\\.[0-9]+)*))"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "lgtm-hq/lgtm-ci",
      "autoReplaceStringTemplate": "ref: \"{{newDigest}}\"  # {{newVersion}}"
    }
  ]
}
